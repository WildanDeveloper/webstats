# WebStats environment file for systemd services.
# Copy to /etc/webstats.env and fill in real values.
#   sudo cp deploy/webstats.env.example /etc/webstats.env
#   sudo nano /etc/webstats.env

# --- Database ---
DATABASE_URL=postgres://webstats:REPLACE_WITH_UNIQUE_RANDOM_32_BYTE_HEX_PASSWORD@127.0.0.1:5432/webstats

# --- Security (change these!) ---
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_32_BYTE_HEX_JWT_SECRET
IP_HASH_SALT=REPLACE_WITH_UNIQUE_RANDOM_32_BYTE_HEX_IP_HASH_SALT

# --- CORS: frontend origin(s), comma separated ---
ALLOW_ORIGINS=https://stats.yourdomain.com

# --- GeoIP (optional): CIDR,CC lines, see backend/data/sample-geo.csv ---
GEO_CSV=/opt/webstats/backend/data/sample-geo.csv

# --- Redis queue mode (optional, leave empty for direct writes) ---
REDIS_URL=

# --- Ingest flood protection (requests per site per minute, 0 = off) ---
RATE_LIMIT_PER_MIN=600

# --- Frontend (single-domain layout: /_api and /_tracker proxied by Caddy) ---
NEXTAUTH_SECRET=REPLACE_WITH_UNIQUE_RANDOM_32_BYTE_HEX_NEXTAUTH_SECRET
NEXTAUTH_URL=https://stats.yourdomain.com
NEXT_PUBLIC_API_URL=https://stats.yourdomain.com/_api
NEXT_PUBLIC_TRACKER_URL=https://stats.yourdomain.com/_tracker
API_SERVER_URL=http://127.0.0.1:8086
APP_PUBLIC_URL=https://stats.yourdomain.com
API_PUBLIC_URL=https://stats.yourdomain.com/_api