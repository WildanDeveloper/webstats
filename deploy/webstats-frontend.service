[Unit]
Description=WebStats Dashboard Web (Next.js)
After=network.target webstats-dashboard.service
Wants=webstats-dashboard.service

[Service]
Type=simple
User=webstats
Group=webstats
NoNewPrivileges=true
WorkingDirectory=/opt/webstats/frontend
EnvironmentFile=/etc/webstats.env
Environment=PORT=3000
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target