[Unit]
Description=WebStats Dashboard Web (Next.js)
After=network.target webstats-dashboard.service
Wants=webstats-dashboard.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/webstats/frontend
EnvironmentFile=/etc/webstats.env
Environment=PORT=3000
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start --prefix /root/webstats/frontend
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target