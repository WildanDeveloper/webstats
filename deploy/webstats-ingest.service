[Unit]
Description=WebStats Ingestion API (tracker endpoint)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=webstats
Group=webstats
NoNewPrivileges=true
WorkingDirectory=/opt/webstats/backend
EnvironmentFile=/etc/webstats.env
Environment=PORT=8085
Environment=BIND=127.0.0.1
ExecStart=/opt/webstats/backend/bin/ingest
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target